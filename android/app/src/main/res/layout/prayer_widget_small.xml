<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1: next prayer and countdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/pw_bg" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/pw_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="2" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/pw_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/pw_sub" android:maxLines="1" />
    </LinearLayout>
    <!-- RTL row: the label sits right of the number, read "متبقٍ 11:33" -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/pw_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="@string/prayer_widget_left" android:textSize="11sp" android:textColor="@color/pw_sub" />
        <Chronometer android:id="@+id/pw_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/pw_primary" android:layoutDirection="ltr" android:textDirection="ltr" />
    </LinearLayout>
</LinearLayout>
