<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2: place and Hijri date, next prayer, progress since the previous
     prayer, and the five times. As in the 4x1 layout, the times row takes the
     height that is left and auto-sizes its text, so a big system font shrinks
     it instead of cutting it off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedAttribute" android:id="@+id/pw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/pw_bg" android:layoutDirection="rtl">
    <TextView android:id="@+id/pw_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/pw_sub" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/pw_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="2" />
            <TextView android:id="@+id/pw_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/pw_sub" android:maxLines="1" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
            <Chronometer android:id="@+id/pw_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/pw_primary" android:layoutDirection="ltr" android:textDirection="ltr" />
            <TextView android:id="@+id/pw_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/prayer_widget_left" android:textSize="11sp" android:textColor="@color/pw_sub" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/pw_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="1000" android:progressTint="@color/pw_primary" android:progressBackgroundTint="@color/pw_track" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/pw_cell0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/pw_cell_off">
            <TextView android:id="@+id/pw_cname0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:textColor="@color/pw_sub" android:maxLines="1" />
            <TextView android:id="@+id/pw_ctime0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:gravity="center" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw_cell1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/pw_cell_off">
            <TextView android:id="@+id/pw_cname1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:textColor="@color/pw_sub" android:maxLines="1" />
            <TextView android:id="@+id/pw_ctime1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:gravity="center" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw_cell2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/pw_cell_off">
            <TextView android:id="@+id/pw_cname2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:textColor="@color/pw_sub" android:maxLines="1" />
            <TextView android:id="@+id/pw_ctime2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:gravity="center" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw_cell3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/pw_cell_off">
            <TextView android:id="@+id/pw_cname3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:textColor="@color/pw_sub" android:maxLines="1" />
            <TextView android:id="@+id/pw_ctime3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:gravity="center" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pw_cell4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/pw_cell_off">
            <TextView android:id="@+id/pw_cname4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:textColor="@color/pw_sub" android:maxLines="1" />
            <TextView android:id="@+id/pw_ctime4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:gravity="center" android:textSize="13sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="13sp" android:textStyle="bold" android:textColor="@color/pw_text" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
